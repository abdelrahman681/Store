@using DashBoard.Models
@model IReadOnlyList<ProductViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">

    <a asp-action="Create"
       asp-controller="Product"
       class="btn btn-outline-primary">
        Add New Product
    </a>

    <form method="get" asp-action="Index" class="d-flex gap-2">

        <select name="sort"
                class="form-select"
                asp-items="ViewBag.Sorts">
        </select>

        <button type="submit" class="btn btn-primary">
            Apply Sort
        </button>

    </form>

</div>

@if (Model.Any())
{
    <div class="container-fluid">

        <table class="table table-hover table-striped table-bordered">
            <thead class="table-dark text-center">
                <tr>
                    <th>Id</th>
                    <th>Picture</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Brand</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>

                        <td>
                            <img src="~/@product.PictureUrl"
                                 width="80"
                                 height="80"
                                 class="img-thumbnail" />
                        </td>

                        <td>@product.Name</td>

                        <td>
                            @(product.Description?.Length > 50
                                ? product.Description.Substring(0, 50) + "..."
                                : product.Description)
                        </td>

                        <td>@product.Price</td>

                        <td>@product.Brand.Name</td>

                        <td>@product.Category.Name</td>

                        <td>
                            <div class="d-flex gap-2">

                                <a class="btn btn-warning btn-sm"
                                   asp-action="Edit"
                                   asp-route-id="@product.Id">
                                    <i class="fas fa-pen"></i>
                                </a>

                                <a class="btn btn-danger btn-sm"
                                   asp-action="Delete"
                                   asp-route-id="@product.Id">
                                    <i class="fas fa-trash"></i>
                                </a>

                            </div>
                        </td>

                    </tr>
                }

            </tbody>
        </table>

        <nav class="mt-3">
            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.PageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageIndex="@(ViewBag.PageIndex - 1)">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPage; i++)
                {
                    <li class="page-item @(i == ViewBag.PageIndex ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageIndex="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(ViewBag.PageIndex >= ViewBag.TotalPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageIndex="@(ViewBag.PageIndex + 1)">
                        Next
                    </a>
                </li>

            </ul>
        </nav>

    </div>
}
else
{
    <div class="alert alert-warning mt-3">
        <h4>No Products Found</h4>
    </div>
}